# ============================================================
# .env.example — contoh konfigurasi (salin menjadi .env)
# ============================================================
# [FUNGSI] Template konfigurasi environment aplikasi.
# [ALASAN] File .env asli berisi rahasia & tidak di-commit; contoh ini
#          jadi acuan supaya orang lain tahu variabel apa saja yang perlu diisi.
#
# Cara pakai: cp .env.example .env  lalu sesuaikan nilainya.

# ---- Database (PostgreSQL) ----
POSTGRES_USER=marms
POSTGRES_PASSWORD=marms_password
POSTGRES_DB=marms

# URL koneksi Prisma.
# - Untuk `npm run dev` di laptop (host), pakai localhost:
DATABASE_URL=postgresql://marms:marms_password@localhost:5432/marms?schema=public
# - Saat jalan di dalam Docker, docker-compose otomatis mengganti `localhost` menjadi `db`.

# ---- Aplikasi ----
PORT=3000
NODE_ENV=development

# Kunci rahasia untuk sesi login (wajib diganti dengan string acak yang panjang)
SESSION_SECRET=ganti-dengan-kunci-rahasia-panjang-acak

# ---- Akun admin awal (dibuat lewat seed) ----
ADMIN_EMAIL=admin@marms.com
ADMIN_PASSWORD=Admin123!
